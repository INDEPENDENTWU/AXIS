{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.flow.v1",
  "title": "AXIS Flow v1",
  "type": "object",
  "required": ["schema", "id", "steps"],
  "properties": {
    "schema": {"const": "axis.flow.v1"},
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "objectRef"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "objectRef": {"type": "string", "minLength": 1},
        "metricOverride": {
          "type": "object",
          "required": ["metrics"],
          "properties": {
            "metrics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"$ref": "./axis-metric-schema-v1.schema.json#/$defs/metric"}
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "executionOverride": {"enum": ["single", "sets", "rounds", "timed", "hold", "complete"]},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 99},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
