{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.playable.v1",
  "title": "AXIS PlayableSpec v1 — bounded executable intent, not workout history",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "compilerVersion",
    "source",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "axis.playable.v1"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "compilerVersion": {
      "const": "8.31a"
    },
    "heading": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[^<>\\\\u0000-\\\\u001F\\\\u007F]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "object",
            "flow"
          ]
        },
        "ref": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\\\u0000-\\\\u001F\\\\u007F]+$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objectRef",
        "executionMode",
        "metricSchemaSnapshot",
        "repeat",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "objectRef": {
          "$ref": "#/$defs/identifier"
        },
        "executionMode": {
          "enum": [
            "single",
            "sets",
            "rounds",
            "timed",
            "hold",
            "complete"
          ]
        },
        "metricSchemaSnapshot": {
          "type": "object",
          "required": [
            "schema",
            "metrics"
          ],
          "properties": {
            "schema": {
              "const": "axis.metric-schema.v1"
            },
            "metrics": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32
            }
          },
          "additionalProperties": true
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metricSchema",
            "executionMode"
          ],
          "properties": {
            "metricSchema": {
              "type": "string",
              "minLength": 1
            },
            "executionMode": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
