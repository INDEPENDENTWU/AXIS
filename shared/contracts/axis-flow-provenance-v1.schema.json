{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.flow-provenance.v1",
  "title": "AXIS Flow Encounter Provenance v1",
  "type": "object",
  "required": ["schema", "flowRef", "flowStepRef", "objectRef", "stepSnapshot"],
  "properties": {
    "schema": {"const": "axis.flow-provenance.v1"},
    "flowRef": {"type": "string", "minLength": 1},
    "flowStepRef": {"type": "string", "minLength": 1},
    "objectRef": {"type": "string", "minLength": 1},
    "stepSnapshot": {
      "type": "object",
      "required": ["repeat", "effectiveMetricIds", "effectiveExecutionMode", "overrideProvenance"],
      "properties": {
        "repeat": {"type": "integer", "minimum": 1},
        "effectiveMetricIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "effectiveExecutionMode": {"enum": ["single", "sets", "rounds", "timed", "hold", "complete"]},
        "overrideProvenance": {
          "type": "object",
          "required": ["metricSchema", "executionMode", "temporary"],
          "properties": {
            "metricSchema": {"type": "string", "minLength": 1},
            "executionMode": {"type": "string", "minLength": 1},
            "temporary": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
