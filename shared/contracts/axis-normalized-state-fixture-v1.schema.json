{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.normalized-state-fixture.v1",
  "title": "AXIS Normalized State Fixture v1",
  "type": "object",
  "required": ["sessionStart", "sessionEnd", "activities"],
  "properties": {
    "sessionStart": {"type": "integer", "minimum": 0},
    "sessionEnd": {"type": "integer", "minimum": 0},
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "intervals"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["strength", "cardio"]},
          "plannedSets": {"type": "integer", "minimum": 0},
          "completedSets": {"type": "integer", "minimum": 0},
          "status": {"type": "string", "enum": ["idle", "active", "paused", "finished"]},
          "intervals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
