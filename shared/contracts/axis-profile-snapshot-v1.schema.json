{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.profile-snapshot.v1",
  "title": "AXIS Profile Snapshot v1",
  "type": "object",
  "required": ["schema", "version", "capturedAt", "measurements", "training"],
  "properties": {
    "schema": {"const": "axis.profile-snapshot.v1"},
    "version": {"const": 1},
    "capturedAt": {"type": "number", "minimum": 0},
    "measurements": {
      "type": "object",
      "required": ["heightCm", "weightKg", "bodyFatPct", "waistCm"],
      "properties": {
        "heightCm": {"type": ["number", "null"], "minimum": 50, "maximum": 300},
        "weightKg": {"type": ["number", "null"], "minimum": 20, "maximum": 500},
        "bodyFatPct": {"type": ["number", "null"], "minimum": 1, "maximum": 75},
        "waistCm": {"type": ["number", "null"], "minimum": 20, "maximum": 300}
      },
      "additionalProperties": true
    },
    "training": {
      "type": "object",
      "required": ["years", "weeklyFrequency"],
      "properties": {
        "years": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "weeklyFrequency": {"type": ["number", "null"], "minimum": 0, "maximum": 14}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
