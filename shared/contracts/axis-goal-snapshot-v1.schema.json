{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.goal-snapshot.v1",
  "title": "AXIS Goal Snapshot v1",
  "type": "object",
  "required": ["schema", "version", "capturedAt", "kind", "targets"],
  "properties": {
    "schema": {"const": "axis.goal-snapshot.v1"},
    "version": {"const": 1},
    "capturedAt": {"type": "number", "minimum": 0},
    "kind": {"type": ["string", "null"]},
    "targets": {
      "type": "object",
      "required": ["weightKg", "bodyFatPct", "waistCm"],
      "properties": {
        "weightKg": {"type": ["number", "null"], "minimum": 20, "maximum": 500},
        "bodyFatPct": {"type": ["number", "null"], "minimum": 1, "maximum": 75},
        "waistCm": {"type": ["number", "null"], "minimum": 20, "maximum": 300}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
