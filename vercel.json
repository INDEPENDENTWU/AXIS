{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "buildCommand":"node prepare-legacy-runtime.mjs && node build-hardened.mjs && node postbuild-kernel-priority.mjs && node postbuild-features-hardened.mjs && node postbuild-8712-completion.mjs",
  "outputDirectory":".",
  "cleanUrls":true,
  "trailingSlash":false,
  "functions":{
    "api/analyze.js":{"maxDuration":30},
    "api/insight.js":{"maxDuration":20},
    "api/ai-status.js":{"maxDuration":10},
    "api/owner-config.js":{"maxDuration":10}
  },
  "headers":[
    {"source":"/","headers":[{"key":"Cache-Control","value":"no-store, no-cache, max-age=0, must-revalidate"},{"key":"CDN-Cache-Control","value":"no-store"},{"key":"Vercel-CDN-Cache-Control","value":"no-store"},{"key":"Pragma","value":"no-cache"},{"key":"Expires","value":"0"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-store, no-cache, max-age=0, must-revalidate"},{"key":"CDN-Cache-Control","value":"no-store"},{"key":"Vercel-CDN-Cache-Control","value":"no-store"}]},
    {"source":"/fresh/(.*)","headers":[{"key":"Cache-Control","value":"no-store, no-cache, max-age=0, must-revalidate"},{"key":"CDN-Cache-Control","value":"no-store"},{"key":"Vercel-CDN-Cache-Control","value":"no-store"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-store, no-cache, max-age=0, must-revalidate"},{"key":"CDN-Cache-Control","value":"no-store"},{"key":"Vercel-CDN-Cache-Control","value":"no-store"},{"key":"Service-Worker-Allowed","value":"/"}]},
    {"source":"/axis-core.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/axis-enhance-foundation.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/axis-enhance-recording.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/axis-enhance-interaction.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/axis-enhance-product.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/axis-style.css","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/v8712-runtime.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/v8712-completion.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/axis-build.json","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/owner.html","headers":[{"key":"Cache-Control","value":"no-store, no-cache, max-age=0, must-revalidate"}]},
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"Permissions-Policy","value":"camera=(self), microphone=(), geolocation=(self), accelerometer=(self), gyroscope=(self)"}
    ]}
  ]
}
