{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "buildCommand":"node scripts/build-vercel.mjs",
  "installCommand":"echo AXIS-no-dependencies",
  "outputDirectory":"dist",
  "cleanUrls":false,
  "trailingSlash":false,
  "functions":{
    "api/analyze.js":{"maxDuration":30},
    "api/insight.js":{"maxDuration":20},
    "api/ai-status.js":{"maxDuration":10},
    "api/owner-config.js":{"maxDuration":10}
  },
  "headers":[
    {"source":"/","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
    {"source":"/app/(.*)","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
    {"source":"/standalone/(.*)","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
    {"source":"/repair/(.*)","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
    {"source":"/axis-runtime-843.js","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/owner.html","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"},{"key":"Service-Worker-Allowed","value":"/"}]},
    {"source":"/manifest.webmanifest","headers":[{"key":"Cache-Control","value":"public, max-age=86400, stale-while-revalidate=604800"}]},
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"Permissions-Policy","value":"camera=(self), microphone=(), geolocation=()"}
    ]}
  ]
}
