{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "cleanUrls":true,
  "trailingSlash":false,
  "functions":{
    "api/analyze.js":{"maxDuration":30},
    "api/insight.js":{"maxDuration":20},
    "api/ai-status.js":{"maxDuration":10},
    "api/owner-config.js":{"maxDuration":10}
  },
  "headers":[
    {"source":"/","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"},{"key":"CDN-Cache-Control","value":"no-store"},{"key":"Vercel-CDN-Cache-Control","value":"no-store"},{"key":"Pragma","value":"no-cache"},{"key":"Expires","value":"0"}]},
    {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"},{"key":"CDN-Cache-Control","value":"no-store"},{"key":"Vercel-CDN-Cache-Control","value":"no-store"}]},
    {"source":"/fresh/index.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"},{"key":"CDN-Cache-Control","value":"no-store"},{"key":"Vercel-CDN-Cache-Control","value":"no-store"}]},
    {"source":"/owner.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/edge-bootstrap.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"},{"key":"CDN-Cache-Control","value":"no-store"},{"key":"Vercel-CDN-Cache-Control","value":"no-store"}]},
    {"source":"/v877-runtime.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/v878-stability.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/v82-runtime.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/v83-reminders.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/sw.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/app.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/styles.css","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/v61.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/v61.css","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"Permissions-Policy","value":"camera=(self), microphone=(), geolocation=(self), accelerometer=(self), gyroscope=(self)"}
    ]}
  ]
}