{
  "buildCommand": "node build.mjs && node postbuild-features.mjs",
  "outputDirectory": ".",
  "nodeVersion": "20.18.0",
  "headers": [
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate"}]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate"}]},
    {"source": "/owner.html", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate"}]},
    {"source": "/fresh/*", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate"}]},
    {"source": "/sw.js", "headers": [{"key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate"}, {"key": "Service-Worker-Allowed", "value": "/"}]},
    {"source": "/axis-core.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/axis-enhance.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/axis-style.css", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/v8712-runtime.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/axis-build.json", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]},
    {"source": "/*", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self), accelerometer=(self), gyroscope=(self)"}
    ]}
  ],
  "cloudFunctions": {
    "mainlandRegions": ["ap-guangzhou"],
    "overseasRegions": ["ap-singapore"],
    "nodejs": {"maxDuration": 30}
  }
}
